    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
